{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The hosted web client may bring the window to the front on incoming calls",
  "windows": ["main"],
  "remote": {
    "urls": ["https://closeby.pendzialek.net/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-request-user-attention"
  ]
}
