{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloseBy",
  "version": "0.1.0",
  "identifier": "net.pendzialek.closeby.desktop",
  "build": {
    "frontendDist": "https://closeby.pendzialek.net"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CloseBy",
        "url": "https://closeby.pendzialek.net",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
